local TweenService = game:GetService("TweenService")
local PlayerGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")

-- إنشاء واجهة التحميل
local LoadingGui = Instance.new("ScreenGui")
LoadingGui.Name = "LoadingGui"
LoadingGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
LoadingGui.IgnoreGuiInset = true
LoadingGui.Parent = PlayerGui

local Background = Instance.new("Frame", LoadingGui)
Background.Size = UDim2.new(1, 0, 1, 0)
Background.BackgroundColor3 = Color3.fromRGB(20, 20, 20) -- لون أسود غامق

local LoadingText = Instance.new("TextLabel", Background)
LoadingText.Size = UDim2.new(0, 200, 0, 50)
LoadingText.Position = UDim2.new(0.5, -100, 0.5, -25)
LoadingText.BackgroundTransparency = 1
LoadingText.TextColor3 = Color3.fromRGB(255, 255, 255)
LoadingText.Text = "جاري تحميل أستاروث..."
LoadingText.Font = Enum.Font.GothamBold
LoadingText.TextSize = 25

-- أنميشن الظهور والاختفاء
local function AnimateLoading()
    -- تأثير شفافية
    LoadingText.TextTransparency = 1
    TweenService:Create(LoadingText, TweenInfo.new(1), {TextTransparency = 0}):Play()
    
    task.wait(2) -- مدة التحميل
    
    -- تلاشي الواجهة عند الانتهاء
    TweenService:Create(Background, TweenInfo.new(0.8), {BackgroundTransparency = 1}):Play()
    TweenService:Create(LoadingText, TweenInfo.new(0.8), {TextTransparency = 1}):Play()
    
    task.wait(0.8)
    LoadingGui:Destroy()
end

task.spawn(AnimateLoading)
-- تحميل المكتبة
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = Library.CreateLib("SCRIPT KILLER", "BloodTheme")


local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

-- (باقي السكربت كما هو في الأعلى...)
-- 1. تبويب السكربتات
local Tab1 = Window:NewTab("سكربتات")
local Section1 = Tab1:NewSection("سكربت المطور استاروث")
Section1:NewButton("vr7", "سكربت المطور استا روث", function() loadstring(game:HttpGet("https://raw.githubusercontent.com/VR7ss/OMK/refs/heads/main/VR7-ON-TOP"))() end)
Section1:NewButton("بروتون الجديد", "ButtonInfo", function() loadstring(game:HttpGet("https://raw.githubusercontent.com/bruton-lua-sources/LOC4T-HUB/refs/heads/main/LOC4T%20HUB"))() end)
Section1:NewButton("سكربت الشات", "ButtonInfo", function() loadstring(game:HttpGet("https://raw.githubusercontent.com/Gaurav-0196/Mickey-Chat/refs/heads/main/MickeyChat"))() end) 

-- 2. تبويب اللاعب
local Tab2 = Window:NewTab("اللاعب")
local Section2 = Tab2:NewSection("تعديلات اللاعب")
Section2:NewSlider("سرعة المشي", "تعديل سرعة اللاعب", 500, 0, function(s) LocalPlayer.Character.Humanoid.WalkSpeed = s end)
Section2:NewSlider("قوة القفز", "تعديل قفزة اللاعب", 500, 0, function(s) LocalPlayer.Character.Humanoid.JumpPower = s end)

local InfiniteJumpEnabled = false
UIS.JumpRequest:Connect(function() if InfiniteJumpEnabled then LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping") end end)
Section2:NewToggle("القفز اللانهائي", "قفز في الهواء", function(state) InfiniteJumpEnabled = state end)

local Flying = false
local FlySpeed = 50
local function StartFlying()
    local hrp = LocalPlayer.Character:WaitForChild("HumanoidRootPart")
    local bv = Instance.new("BodyVelocity", hrp) bv.MaxForce = Vector3.new(1/0, 1/0, 1/0) bv.Velocity = Vector3.zero
    local bg = Instance.new("BodyGyro", hrp) bg.MaxTorque = Vector3.new(1/0, 1/0, 1/0) bg.CFrame = hrp.CFrame
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not Flying then bv:Destroy() bg:Destroy() connection:Disconnect() return end
        local cam = workspace.CurrentCamera
        local moveDir = Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir += cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir -= cam.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir -= cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir += cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.new(0, 1, 0) end
        bv.Velocity = moveDir * FlySpeed
        bg.CFrame = cam.CFrame
    end)
end
Section2:NewToggle("تفعيل الطيران", "استخدم WASD للتحرك", function(state) Flying = state if Flying then StartFlying() end end)
Section2:NewSlider("سرعة الطيران", "تعديل سرعة الطيران", 200, 10, function(s) FlySpeed = s end)

-- 3. تبويب أدوات التخريب
local Tab3 = Window:NewTab("أدوات التخريب")
local Section3 = Tab3:NewSection("أدوات Skybox")
local animTracks, savedBody = {}, {}
local function stopSkybox()
    for _, track in pairs(animTracks) do pcall(function() track:Stop() track:Destroy() end) end
    animTracks = {}
    if next(savedBody) then
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then pcall(function() ReplicatedStorage.Remotes.ChangeCharacterBody:InvokeServer({savedBody.Torso, savedBody.RightArm, savedBody.LeftArm, savedBody.RightLeg, savedBody.LeftLeg, savedBody.Head}) end) savedBody = {} end
    end
end
local function startSkybox()
    local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local desc = humanoid:GetAppliedDescription()
    savedBody = {Torso=desc.Torso, RightArm=desc.RightArm, LeftArm=desc.LeftArm, RightLeg=desc.RightLeg, LeftLeg=desc.LeftLeg, Head=desc.Head}
    pcall(function() ReplicatedStorage.Remotes.ChangeCharacterBody:InvokeServer({123402086843885, 100839513065432, 78300682916056, 86276701020724, 78409653958165, 15093053680}) end)
    task.wait(0.3)
    local anim1 = Instance.new("Animation") anim1.AnimationId = "rbxassetid://70883871260184"
    local track1 = humanoid:LoadAnimation(anim1) track1:Play(0.1, 1, 0.01) table.insert(animTracks, track1)
end
Section3:NewToggle("تفعيل Skybox", "تشغيل/إيقاف التأثير", function(state) if state then startSkybox() else stopSkybox() end end)

local SpamSpeed = 1
local phoneAuto = false
Section3:NewSlider("قوة السبام", "عدد النقرات", 1000, 1, function(s) SpamSpeed = s end)
Section3:NewButton("انتقال للمحل", "الانتقال وتغيير المحل", function()
    LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(-118.8, 21.5, 245.5)
    task.wait(0.5) pcall(function() ReplicatedStorage.Remotes.ChangeStore:FireServer() end)
end)
Section3:NewToggle("تفعيل تجميع الهواتف (التصاق)", "ابدأ التجميع", function(state)
    phoneAuto = state
    task.spawn(function()
        while phoneAuto do
            local phone = Workspace:FindFirstChild("WorkspaceCom") and Workspace.WorkspaceCom["001_CommercialStores"].CommercialStorage1.Store.Tools:FindFirstChild("Iphone")
            if phone and phone:FindFirstChild("ClickDetector") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = phone.CFrame + Vector3.new(0, 2, 0)
                for i = 1, SpamSpeed do fireclickdetector(phone.ClickDetector) end
            end
            task.wait(0.05)
        end
    end)
end)
-- أضف هذا التبويب إلى السكربت الخاص بك
local TabLag = Window:NewTab("مُدمر السيرفر")
local SectionLag = TabLag:NewSection("أدوات اللاق")

-- 1. سبام قطع (Parts) في السيرفر (يسبب لاق شديد)
SectionLag:NewButton("إغراق السيرفر بـ Parts", "يسبب لاق للجميع", function()
    for i = 1, 500 do
        task.spawn(function()
            while true do
                local p = Instance.new("Part", Workspace)
                p.Size = Vector3.new(100, 100, 100)
                p.Position = Vector3.new(math.random(-500, 500), 500, math.random(-500, 500))
                task.wait(0.01)
            end
        end)
    end
end)

-- 2. سبام الأصوات (يسبب لاق صوتي وكراش)
SectionLag:NewButton("سبام أصوات (Sound Spam)", "يسبب كراش صوتي", function()
    for i = 1, 100 do
        task.spawn(function()
            while true do
                local s = Instance.new("Sound", Workspace)
                s.SoundId = "rbxassetid://12221191" -- أي صوت
                s:Play()
                task.wait(0.01)
            end
        end)
    end
end)

-- 3. سبام الهزات (Fling Spam)
SectionLag:NewButton("سبام دفع اللاعبين", "يسبب لاق حركة للجميع", function()
    task.spawn(function()
        while true do
            for _, player in pairs(Players:GetPlayers()) do
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    player.Character.HumanoidRootPart.Velocity = Vector3.new(99999, 99999, 99999)
                end
            end
            task.wait(0.01)
        end
    end)
end)
